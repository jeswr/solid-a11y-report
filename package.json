{
  "name": "@jeswr/solid-a11y-report",
  "version": "0.1.0",
  "description": "The typed EARL (Evaluation And Report Language) RDF data-model for accessibility test results — build/serialise/parse EARL 1.0 + ACT Rules Format assertions (axe-shaped scans → WCAG success-criterion outcomes) via typed @rdfjs/wrapper accessors, plus the SHACL shape that pins the contract.",
  "type": "module",
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeswr/solid-a11y-report.git"
  },
  "homepage": "https://github.com/jeswr/solid-a11y-report#readme",
  "bugs": {
    "url": "https://github.com/jeswr/solid-a11y-report/issues"
  },
  "keywords": [
    "solid",
    "rdf",
    "earl",
    "accessibility",
    "a11y",
    "wcag",
    "act-rules",
    "axe",
    "shacl"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./earl": {
      "types": "./dist/earl.d.ts",
      "import": "./dist/earl.js"
    },
    "./wcag": {
      "types": "./dist/wcag.d.ts",
      "import": "./dist/wcag.js"
    },
    "./shape": {
      "import": "./dist/shape.js",
      "types": "./dist/shape.d.ts"
    },
    "./shapes/a11y-report.ttl": "./shapes/a11y-report.ttl"
  },
  "files": [
    "dist",
    "shapes",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dist && npm run check:lockfile-transport",
    "check:dist": "node scripts/check-dist.mjs",
    "check:lockfile-transport": "node scripts/check-lockfile-transport.mjs",
    "api:report": "npm run build && npx --yes @microsoft/api-extractor@7 run --local",
    "api:check": "npm run build && npx --yes @microsoft/api-extractor@7 run"
  },
  "dependencies": {
    "@jeswr/fetch-rdf": "^0.1.0",
    "@rdfjs/wrapper": "^0.34.0",
    "n3": "^2.0.3"
  },
  "peerDependencies": {
    "@rdfjs/types": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "@types/node": "^20",
    "@zazuko/env-node": "^3.0.0",
    "esbuild": "^0.25.0",
    "rdf-validate-shacl": "^0.6.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
